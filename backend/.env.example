# Copy to backend/.env on the server. Never commit the real file.
GEMINI_API_KEY=
SWIGGY_MODE=mcp
# Copy these three from the backend/.env on the laptop where you ran "Connect Swiggy".
SWIGGY_MCP_TOKEN=
SWIGGY_REFRESH_TOKEN=
SWIGGY_CLIENT_ID=
# Long random string: python3 -c "import secrets;print(secrets.token_hex(32))"
FORKCAST_SECRET=
# The website's address(es), comma-separated, no trailing slash
FORKCAST_ORIGINS=https://your-app.vercel.app
